{
  "name": "it-support",
  "version": "1.0.14",
  "description": "IT Support Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "dist": "npm run build-win"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.gti.itsupport",
    "productName": "IT Support",
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "it_support.png",
      "build_icon.ico",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "build_icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
